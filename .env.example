# Llama Model Configuration
# Choose between Llama 3.1 instruct models:
# - meta-llama/Meta-Llama-3.1-8B-Instruct (smaller, faster)
# - meta-llama/Meta-Llama-3.1-70B-Instruct (larger, better quality)
LLAMA_MODEL=meta-llama/Meta-Llama-3.1-8B-Instruct

# Use 8-bit quantization to reduce memory usage
# Set to "false" if you have enough GPU memory
USE_8BIT=true
